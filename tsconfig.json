{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "lib": ["ES2022", "DOM"],
    "baseUrl": ".",
    "esModuleInterop": true,
    "strict": true,
    "paths": {
      "@lib/*": ["lib/*"],
      "@helpers/*": ["lib/helpers/*"],
      "@api/*": ["lib/api/*"],
      "@data/*": ["lib/data/*"],
      "@pages/*": ["lib/pages/*"],
      "@root/*": ["./*"]
    }
  }
}
